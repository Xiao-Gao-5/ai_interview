# DashScope keys. Use either one key or a comma-separated key pool.
DASHSCOPE_API_KEY=your-dashscope-api-key
# DASHSCOPE_API_KEYS=key-1,key-2,key-3

# Qwen models.
QWEN_MODEL=qwen-plus
QWEN_EVAL_MODEL=qwen-plus
QWEN_MODELS=qwen-plus,qwen-turbo

# DashScope embedding model.
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Optional paths.
DATA_DIR=./data
KNOWLEDGE_FILE=./cs_knowledge.json

# Optional named model config for future multi-provider routing.
# MODEL_CONFIG_JSON={"interviewer":{"provider":"dashscope","model":"qwen-plus"}}
